# Copy this file to .env.local and fill in what you need.
# With NOTHING filled in, the app runs fully local on a Hardhat chain (npm run chain).

# --- AI (optional) ---
# Free key from https://aistudio.google.com  (without it, the AI Deal Maker uses its rules only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Blockchain ---
# Leave empty for local Hardhat. For BNB Smart Chain Testnet:
# RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
RPC_URL=

# Testnet only. TEST wallets only, never a wallet with real money.
# DEPLOYER_PRIVATE_KEY deploys the contract; AGENT_ADDRESS is the AI Deal Maker's wallet address.
DEPLOYER_PRIVATE_KEY=
AGENT_ADDRESS=
AGENT_PRIVATE_KEY=
# One funded test wallet can play the buyer, neighbors and coordinator roles:
DEMO_PRIVATE_KEY=
# Optional per-role overrides:
BUYER_PRIVATE_KEY=
NEIGHBORS_PRIVATE_KEY=
COORDINATOR_PRIVATE_KEY=
# Where the money goes on release (any addresses you control):
FARMER_ADDRESS=
HAULER_ADDRESS=

# How many wei equal ₱1 on-chain (default 1e12 -> ₱70 = 0.00007 tBNB), keeps faucet tBNB enough for demos.
WEI_PER_PESO=1000000000000
